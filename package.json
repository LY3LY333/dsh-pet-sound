{
  "name": "dsh-pet-sound",
  "version": "0.1.0",
  "description": "DeepSeek Harness (dsh) desktop pet click sound patcher — idempotent apply/revert CLI, zero dependencies.",
  "type": "module",
  "bin": {
    "dsh-pet-sound": "bin/dsh-pet-sound.js"
  },
  "exports": {
    ".": "./src/patch.js",
