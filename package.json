    "sound-effects",
    "web-audio",
    "patcher",
    "cli",
    "nodejs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LY3LY333/dsh-pet-sound.git"
  },
